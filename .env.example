# Copy this file to .env.local and fill in whichever keys you have.
# Workly runs fully in demo mode (seeded in-memory data, mocked email/billing,
# a map-less list fallback) with NONE of these set — see README § Demo mode.

# --- Supabase ---------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard -> your project -> Settings -> API
# Enables real auth + Postgres instead of the in-memory seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, never exposed to the browser. Keep this out of git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com/test/apikeys (use test-mode keys)
# Enables real operator subscription checkout (currently mocked in lib/billing.ts).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend -------------------------------------------------------------
# Dashboard: https://resend.com/api-keys
# Enables real transactional email (currently logged to the console in lib/email.ts).
RESEND_API_KEY=

# --- Mapbox -------------------------------------------------------------
# Dashboard: https://account.mapbox.com/access-tokens
# Public token (starts with "pk.") — safe to expose client-side by design.
# Enables the interactive map on /search and space detail pages.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- App ------------------------------------------------------------------
# Used for absolute URLs in metadata, sitemap.xml, and emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
